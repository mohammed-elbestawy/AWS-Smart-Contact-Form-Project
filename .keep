flowchart TB
    User["👤 User"]

    User --> CloudFront["☁️ CloudFront<br/>HTTPS delivery"]
    CloudFront --> S3["🪣 S3 Bucket (Private)<br/>Static frontend - OAC only"]

    User --> WAF["🛡️ AWS WAF<br/>Rate limit + Core rules"]
    WAF --> APIGW["🔌 API Gateway<br/>REST API"]

    APIGW -->|"POST /submit"| SubmitLambda["⚡ Lambda<br/>submit-handler"]
    APIGW -->|"GET /messages"| GetLambda["⚡ Lambda<br/>get-messages"]

    Cognito["🔑 Cognito<br/>Admin authentication"] -.->|"Authorizes"| APIGW

    SubmitLambda --> SQS["📬 SQS Queue<br/>contact-messages-queue"]
    SQS -->|"Trigger"| ProcessLambda["⚡ Lambda<br/>message-processor"]

    ProcessLambda --> Comprehend["🤖 Amazon Comprehend<br/>Sentiment analysis"]
    ProcessLambda --> DynamoDB["🗃️ DynamoDB<br/>contact-messages"]
    ProcessLambda -->|"Only if not spam"| SNS["📣 SNS<br/>contact-notifications"]

    SNS --> Email["📧 Site Owner Inbox"]

    GetLambda -.->|"Reads"| DynamoDB
